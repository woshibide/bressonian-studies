{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Release",
      "type": "shell",
      "command": "make -j -s",
      "problemMatcher": "$gcc",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Run Release",
      "type": "shell",
      "command": "open bin/helloOpenCv.app",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Build and Run Release",
      "dependsOn": ["Build Release", "Run Release"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Build Debug",
      "type": "shell",
      "command": "make Debug -j -s",
      "problemMatcher": "$gcc",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Run Debug",
      "type": "shell",
      "command": "open bin/helloOpenCv_debug.app",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": "$gcc"
    }
  ]
}
